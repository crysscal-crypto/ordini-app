{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordini-app",
  "compatibility_date": "2026-11-01",
  // app statica (React + Firebase): i file esistenti vengono serviti così come sono,
  // ogni altro indirizzo apre l'app (come le "rewrites" di vercel.json)
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
